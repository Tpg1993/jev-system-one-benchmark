# ==============================================================================
# Security & Credentials - DO NOT COMMIT SENSITIVE FILES
# ==============================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx
*.p12
credentials.json
secrets.yaml
secrets.json

# ==============================================================================
# Python Environment & Bytecode
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

