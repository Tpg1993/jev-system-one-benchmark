# ==============================================================================
# Environment Configuration Template (Copy to .env and fill in values)
# NOTE: DO NOT COMMIT REAL SECRETS TO VERSION CONTROL!
# ==============================================================================

# Application Environment
APP_ENV=development                    # development, staging, production
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Security & Authentication (RBAC)
# Generate a strong key with: openssl rand -hex 32
JWT_SECRET_KEY=your-jwt-secret-key-replace-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Default Admin Credentials for Initial Setup
INIT_ADMIN_EMAIL=admin@example.com
INIT_ADMIN_PASSWORD=change-me-strong-admin-password

# Primary LLM: Sarvam AI
SARVAM_API_KEY=your-sarvam-api-key-here
SARVAM_BASE_URL=https://api.sarvam.ai/v1
SARVAM_MODEL_NAME=sarvam-105b
SARVAM_TIMEOUT_SECONDS=60
SARVAM_MAX_RETRIES=2

# Fallback LLM: OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o
OPENAI_TIMEOUT_SECONDS=45

# JEV Configuration (Optimization & Acceleration Layer)
JEV_ENABLED=true
JEV_HOST=localhost
JEV_PORT=9000
JEV_CACHE_ENABLED=true
JEV_CACHE_TTL_SECONDS=3600
JEV_KV_CACHE_OPTIMIZATION=true

# Dynamic Path Configuration (Relative to project root, override if needed)
# Avoid hardcoded absolute machine paths!
DATA_DIR=./data
LOG_DIR=./logs
RESULTS_DIR=./benchmark_results

# Benchmark Parameters
BENCHMARK_CONCURRENCY_LEVELS=1,5,10,25,50
BENCHMARK_PROMPT_DATASET_PATH=./data/sample_prompts.json
BENCHMARK_WARMUP_REQUESTS=5
BENCHMARK_ITERATIONS_PER_LEVEL=20

# Selenium UI Testing Configuration
SELENIUM_HEADLESS=true
SELENIUM_BROWSER=chrome
SELENIUM_BASE_URL=http://localhost:8000
